//Program 3
//Equilateral Triangle
#include <iostream>
using namespace std;
int main(){
    int s1,s2,s3;
    cin>>s1>>s2>>s3;
    bool isEqui=(s1>0)&&(s1==s2)&&(s2==s3);
    cout<<isEqui<<endl;
    return 0;
}


//Program 4
//swapping values
#include<iostream>
using namespace std;
int main (){
    int a , b; 
    cin >> a>> b ; 
    // logic is to swap variable values 
    int temp = a; 
    a=b; 
    b=temp; 
    cout<<a<<"\n"<<b<< endl;
    return 0 ; 
}


