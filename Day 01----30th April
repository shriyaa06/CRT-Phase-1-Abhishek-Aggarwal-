// Program 1
//Converting celcius into fahrenheit
#include <iostream>
using namespace std;
int main(){
    double celcius , fahrenheit; 
    cin>>celcius;
    fahrenheit=(celcius * 9.0/5.0) + 32;
    cout<< fahrenheit<<endl;
    return 0;
}


