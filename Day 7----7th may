//Program 2(7.3 of Day 6)
//Protected(Creating a family vault locker)

#include <iostream>
using namespace std;

class Parent{
protected:
      int secretCode=1234;
};

class Child : public Parent{
    public:
    void accessLocker(){
        cout<<"Code is:"<<secretCode;
    }
    
};

int main(){
    Child obj1;
    obj1.accessLocker();
    
}


//Program 3
//Call by value and reference

#include <iostream>
using namespace std;

void updateByValue(int a){
    a=500;
}

void updateByReference(int &a){
    a=500;
}

int main(){
    int original=100;
    updateByValue(original);
    cout<< original<<"\n";
    updateByReference(original);
    cout<< original;
}


