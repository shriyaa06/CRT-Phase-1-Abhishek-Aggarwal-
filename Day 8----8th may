//Program 1
//Types of Inheritance
//1.1 -- Single inheritance

#include <iostream>
using namespace std;

class vehicle{
public:
    void start(){
        cout<<"Vehicle starts."<<"\n";
    }
};
class Car: public vehicle{
public:
    void drive(){
        cout<<"Car is Driving."<<"\n";
    }
};
int main(){
    Car obj1;
    obj1.start();
    obj1.drive();
}


//Program 2
//1.2-- Multilevel Inheritance

#include <iostream>
using namespace std;

class vehicle{
public:
    void start(){
        cout<<"Vehicle starts."<<"\n";
    }
};
class Car: public vehicle{
public:
    void drive(){
        cout<<"Car is Driving."<<"\n";
    }
};
class Speedometer:public Car {
public:
        void speed(){
        cout<<"Car is running at 70 km/hr."<<"\n";
    }
};
int main(){
    Speedometer obj1;
    obj1.start();
    obj1.drive();
    obj1.speed();
}


//Program 3
//1.3 Hierarchical Inheritance

#include <iostream>
using namespace std;

class vehicle{
public:
    void start(){
        cout<<"Vehicle starts."<<"\n";
    }
};
class Car: public vehicle{
public:
    void drive(){
        cout<<"Car is Driving."<<"\n";
        cout<<"\n";
    }
};
class Bike: public vehicle{
public:
    void drive(){
        cout<<"Bike is Driving."<<"\n";
    }
};
int main(){
    Car obj1;
    obj1.start();
    obj1.drive();
    
    Bike obj2;
    obj2.start();
    obj2.drive();
}


