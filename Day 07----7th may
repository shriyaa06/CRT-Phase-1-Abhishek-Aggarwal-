//Program 6
//Constructor Overloading

#include <iostream>
using namespace std;

class rectangle{
public:
    int length;
    int breadth;

    //CONSTRUCTOR MAKING---(DEFAULT - no value)
    rectangle(){
        length=10;
        breadth=20;
    } 
    //CONSTRUCTOR MAKING---(PARAMETERIZED with 1 value)
    rectangle(int l){
        length=l;
        breadth=20;
    }
    //CONSTRUCTOR MAKING---(PARAMETERIZED with 2 value)
    rectangle(int l, int b){
        length=l;
        breadth=b;
    }
void area(){
    cout<<"Area:"<< length*breadth<<"\n";
    }
};

int main(){
    rectangle r1;
    r1.area();
    rectangle r2(50);
    r2.area();
    rectangle r3(5,2);
    r3.area();
}





