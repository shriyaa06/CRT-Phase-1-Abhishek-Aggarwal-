//Program 3
//Call by value and reference

#include <iostream>
using namespace std;

void updateByValue(int a){
    a=500;
}

void updateByReference(int &a){
    a=500;
}

int main(){
    int original=100;
    updateByValue(original);
    cout<< original<<"\n";
    updateByReference(original);
    cout<< original;
}


