//Program 1
//Printing triangle pattern
*
* *
* * *
* * * *
* * *
* * 
* 

#include <iostream>
using namespace std;
int main(){
    int n;
    cout<<"Enter rows:";
    cin>>n;
    //Upper triangle
        for(int i=1;i<=n;i++){
            for(int j=1;j<=i;j++){
                cout<<"*"<<" ";
            }
            cout<<"\n";
        }
    //Lower triangle
    for(int i=n-1;i>=1;i--){
            for(int j=1;j<=i;j++){
                cout<<"*"<<" ";
            }
            cout<<"\n";
        }
}




