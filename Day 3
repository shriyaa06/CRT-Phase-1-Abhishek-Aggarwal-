//Program 1
// printing 1-10 using for loop
#include <iostream>
using namespace std;
int main(){
    for (int i=1;i<=10;i++){
        cout<<i<<" ";
    }
}

//Program 2
// printing 1-10 using while loop
#include <iostream>
using namespace std;
int main(){
    int i=1;
    while(i<=10){
        cout<<i<<" ";
        i++;
    }
}


//Program 3
// printing 1-10 using do while loop
#include <iostream>
using namespace std;
int main(){
    int i=1;
    do{
        cout<<i<<" ";
        i++;
    }
    while(i<=10);
    
}


//Program 4
// printing odd numbers between 1-10 using while loop
#include <iostream>
using namespace std;
int main(){
    int i=1;
    while(i<=10){
        cout<<i<<" ";
        i+=2;
    }
}


//Program 5
// printing even numbers between 0-10 using for loop
#include <iostream>
using namespace std;
int main(){
    for (int i=0;i<=10;i+=2){
        cout<<i<<" ";
    }
    
}


//Program 6
//printing factorial of a number
#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int fact =1;
    for (int i=n;i>=1;i--){
        fact=fact*i;
    }
    cout<<fact;
}


//Program 7
//Prime number or not using boolean variables
#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    bool isPrime=true;
    
    if(n<2){
        isPrime=false;
    }else{
        for (int i=2;i<n;i++){
            if(n%i==0){
                isPrime=false;
                break;
            }
        }
    }
if(isPrime){
    cout<<"It is a prime number";
}else{
    cout<<"It is not a prime number";
    }
}


