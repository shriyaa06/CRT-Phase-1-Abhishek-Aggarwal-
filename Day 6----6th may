//Program 1
//Calculating total bill of coffee
#include <iostream>
using namespace std;
int price(int coffee){
    return coffee*30;
}
int main(){
    int n;
    cout<<"enter no of coffee:";
    cin>>n;
    int p=price(n);
    cout<<"Bill:"<<p;
}


//Program 2
//Calculating total bill after 10% discount
#include <iostream>
using namespace std;
int bill(int price){
    return (price-(price*10/100));
}
int main(){
    int n;
    cout<<"enter your bill amount:";
    cin>>n;
    int p=bill(n);
    cout<<"Discounted Bill is :"<<p;
}


//Program 3
//Smart AC remote
#include <iostream>
using namespace std;
void setTemperature(){
    cout<<"Temperature set to 22°C"<<"\n";
}
void setTemperature(double temp){
    cout<<"Temperature set to "<<temp<<"°C"<<"\n";
}
void setTemperature(string mode){
    if(mode=="ECO"){
        cout<<"Temperature set to 24°C"<<"\n";
    }else if(mode=="TURBO"){
        cout<<"Temperature set to 18°C"<<"\n";
    }
}
int main(){
    setTemperature();
    setTemperature(25.5);
    setTemperature("ECO");
}


