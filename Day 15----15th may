//Program 1
//Reversing an array using stack (push,pop,top function)

#include <iostream>
#include <stack>
using namespace std;
int main(){
    int arr[]={10,20,30,40,50};
    int n=5;
    
    stack<int> st;
    //JAVA -- stack<integer> st=new Stack();
    
    //Push the data into the stack
    for(int i=0;i<n;i++){
        st.push(arr[i]);
    }
    
    //Pop out the top most data from thr stack and put into the array
    for(int i=0;i<n;i++){
        arr[i]=st.top();
        st.pop();
    }
    cout<<"Reversed Array...";
    
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
    return 0;
}


//Program 2
//Reverse a string (leetcode 344)

class Solution {                                     //USING DOUBLE FOR LOOP
public:
    void reverseString(vector<char>& s) {
        stack<char> st;
        for(int i=0;i<s.size();i++){
            st.push(s[i]);
        }
        int i=0;
        for(int i=0;i<s.size();i++){
            s[i]=st.top();
            st.pop();
         }
    }    
};


class Solution {                                   //USING WHILE LOOP AND (IS EMPTY FUNCTION)
public:
    void reverseString(vector<char>& s) {
        stack<char> st;
        for(int i=0;i<s.size();i++){
            st.push(s[i]);
        }

        int i=0;
        while(!st.empty()){
            s[i++]=st.top();
            st.pop();
        }
    }    
};



//Program 3
//Valid Parantheses (leetcode 20)

class Solution {
public:
    bool isValid(string s) {
        stack <char> st;

        for(char c:s){
            if(c=='(')
               st.push(')');
            else if(c=='[')
                st.push(']');
            else if(c=='{')
                st.push('}');
            else{
                if(st.empty() || st.top() !=c){
                    return false;
                }st.pop();
            }
        }
        return st.empty();
    }
};


//Program 4
//Next Larger Element (GEEKS FOR GEEKS question)

class Solution{
    public:
    vector<int> nextLargerElement(vector<int>&arr){
        int n=arr.size();
        stack<int> st;
        vector<int> nge(n);
        
        for(int i=n-1;i>=0;i--){
            while(!st.empty() && st.top()<=arr[i]){
                st.pop();
            }
            if(st.empty()){
                nge[i]=-1;
            }else{
                nge[i]=st.top();
            }
            st.push(arr[i]);
        }
        return nge;
    }
};


