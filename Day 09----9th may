//To seach an element's in a given array and returning it's index (LINEAR SEARCH)

#include <iostream>
using namespace std;

int main(){
    int arr[5]={10,20,30,40,50};
    int n;
    cout<<"Enter element to search";
    cin>>n;
    for(int i=0;i<5;i++){
        if(arr[i]==n){
            cout<<"Element present at index:"<<i;
            return 0;
        }
    }cout<<"Element not found";
}


