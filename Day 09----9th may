//Program 3
//Adding the data is an array

#include <iostream>
using namespace std;

int main(){
    int arr[5];
    int sum=0;
    cout<<"Enter 5 numbers: ";
    for(int i=0;i<5;i++){
        cin>>arr[i];
    }
    cout<<"Array elements are: ";
    for(int j=0;j<5;j++){
        cout<<arr[j]<<" ";
        sum+=arr[j];
    }cout<<"\n"<<"Sum is: "<<sum;
}


